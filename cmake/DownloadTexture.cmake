if(NOT EXISTS "${TEXTURE_SOURCE}")
    get_filename_component(texture_dir "${TEXTURE_SOURCE}" DIRECTORY)
    file(MAKE_DIRECTORY "${texture_dir}")
    set(download "${TEXTURE_SOURCE}.download")
    message(STATUS "Downloading ${TEXTURE_URL}")
    file(DOWNLOAD "${TEXTURE_URL}" "${download}"
         STATUS download_status TLS_VERIFY ON TIMEOUT 120)
    list(GET download_status 0 status_code)
    list(GET download_status 1 status_message)
    if(NOT status_code EQUAL 0)
        file(REMOVE "${download}")
        message(FATAL_ERROR "Asset download failed: ${status_message}")
    endif()
    file(SHA256 "${download}" actual_sha256)
    if(NOT actual_sha256 STREQUAL TEXTURE_SHA256)
        file(REMOVE "${download}")
        message(FATAL_ERROR "Downloaded asset has an unexpected SHA-256 hash: ${TEXTURE_URL}")
    endif()
    file(RENAME "${download}" "${TEXTURE_SOURCE}")
endif()

file(SHA256 "${TEXTURE_SOURCE}" actual_sha256)
if(NOT actual_sha256 STREQUAL TEXTURE_SHA256)
    message(FATAL_ERROR "Asset has an unexpected SHA-256 hash: ${TEXTURE_SOURCE}")
endif()
configure_file("${TEXTURE_SOURCE}" "${TEXTURE_OUTPUT}" COPYONLY)
